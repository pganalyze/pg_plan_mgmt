-- Bad arguments.
SELECT plan_mgmt.set_plan_status(1, 1, 'bogus');
ERROR:  invalid plan status "bogus"
HINT:  Valid statuses are "Approved", "Unapproved", "Preferred", and "Rejected".
SELECT plan_mgmt.set_plan_status(1, 1, 'approved');
ERROR:  plan 1 of query 1 does not exist
SELECT plan_mgmt.set_plan_enabled(1, 1, true);
ERROR:  plan 1 of query 1 does not exist
SELECT plan_mgmt.delete_plan(1, 1);
 delete_plan 
-------------
           0
(1 row)

SELECT * FROM plan_mgmt.validate_plans('bogus');
ERROR:  invalid action "bogus"
HINT:  Valid actions are "update", "disable", and "delete".
SELECT plan_mgmt.add_plan('SELECT 1; SELECT 2', 'SEQ_SCAN(x)');
ERROR:  statement text must contain exactly one statement
SELECT plan_mgmt.add_plan('VACUUM pm_dim', 'SEQ_SCAN(pm_dim)');
ERROR:  utility statements cannot have plans
SELECT plan_mgmt.add_plan('SELECT * FROM pm_dim', 'INDEX_SCAN(pm_dim no_such_idx)');
ERROR:  plan outline could not be enforced
DETAIL:  INDEX_SCAN(pm_dim no_such_idx) (flags 0x17)
SELECT plan_mgmt.add_plan('SELECT * FROM pm_dim', 'not advice');
WARNING:  could not parse supplied advice: syntax error at or near "not"
ERROR:  plan outline could not be enforced
DETAIL:  pg_plan_advice reported no feedback; the outline may not be valid advice, or another advisor supplied advice
-- add_plan stores the regenerated, canonical outline; EXPLAIN is unwrapped.
SELECT plan_mgmt.add_plan('EXPLAIN (COSTS OFF) SELECT * FROM pm_dim WHERE id = $1',
						  'BITMAP_HEAP_SCAN(pm_dim)', 'unapproved')
  IS NOT NULL;
 ?column? 
----------
 t
(1 row)

SELECT status, origin, sql_text, plan_outline FROM plan_mgmt.dba_plans;
   status   | origin |              sql_text              |       plan_outline       
------------+--------+------------------------------------+--------------------------
 Unapproved | User   | SELECT * FROM pm_dim WHERE id = $1 | BITMAP_HEAP_SCAN(pm_dim)+
            |        |                                    | NO_GATHER(pm_dim)
(1 row)

-- Adding the same plan again only updates it.
SELECT plan_mgmt.add_plan('SELECT * FROM pm_dim WHERE id = $1',
						  'BITMAP_HEAP_SCAN(pm_dim)', 'approved', false)
  IS NOT NULL;
 ?column? 
----------
 t
(1 row)

