-- A second plan, using an index we're about to drop.
CREATE INDEX pm_dim_val_idx ON pm_dim (val);
SELECT plan_mgmt.add_plan('SELECT * FROM pm_dim WHERE id = $1 AND val = $2',
						  'INDEX_SCAN(pm_dim pm_dim_val_idx)') IS NOT NULL;
 ?column? 
----------
 t
(1 row)

